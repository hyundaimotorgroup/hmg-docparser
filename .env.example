# Private credentials: .env is ignored by Git. Never commit it.
# Copy .env.example to .env and fill only the services you use.
# Defaults and optional overrides are documented in configs/ and docs/configuration.md.
# Text and PDF crops are sent to the configured LOCAL_LLM_BASE_URL.

# Local LLM API: OpenAI calls for every profile except group_internal.
# Text and all VLM tiers share this endpoint and key.
LOCAL_LLM_BASE_URL=https://api.openai.com/v1
LOCAL_LLM_MODEL=gpt-6-luna
LOCAL_LIGHT_VLM_MODEL=gpt-6-luna
LOCAL_MEDIUM_VLM_MODEL=gpt-6-luna
LOCAL_HEAVY_VLM_MODEL=gpt-6.1-sol
LOCAL_LLM_API_KEY=

# Router used by all four PDF profiles; clean Conda starts it on CPU.
ROUTER_SERVER_URL=http://127.0.0.1:8001
# Local quickstart uses Dolphin 1.5 and Paddle FastAPI.
LOCAL_DOLPHIN_URL=http://127.0.0.1:8200
LOCAL_PADDLE_URL=http://127.0.0.1:8100
# Dolphin v2 / Paddle Triton: default, managed_endpoints and group_internal.
DOLPHIN_SERVER_URL=
PADDLE_SERVER_URL=
PADDLE_TOKEN=
# Default/managed/group: true for HTTPS, false for HTTP.
PADDLE_SSL=true

# Internal API: group_internal and the beta pipeline under performance validation.
# Beta fixes restoration roles to Luna/openai and Flash/gemini; no automatic internal reasoning.
LLM_INTERNAL_API_LIGHT_VLM_MODEL=gpt-6-luna
LLM_INTERNAL_API_MEDIUM_VLM_MODEL=gemini-3.8-flash
LLM_INTERNAL_API_HEAVY_VLM_MODEL=gemini-3.8-flash
LLM_INTERNAL_API_BASE_URL=
LLM_INTERNAL_API_KEY=
LLM_INTERNAL_API_PROJECT_ID=

# Optional telemetry (enable langfuse.on in YAML).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional Confluence upload (configs/optional/confluence_upload.yaml).
# CONFLUENCE_EMAIL is for Cloud API token auth; leave empty for Bearer auth.
CONFLUENCE_INPUT_PATH=
CONFLUENCE_OUTPUT_DIR=
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_EMAIL=
CONFLUENCE_SPACE_ID=
CONFLUENCE_PARENT_ID=
